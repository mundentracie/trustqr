{
  "manifest_version": 3,
  "name": "TrustQR — Open Source QR Code Generator",
  "version": "0.1.0",
  "description": "Privacy-first, open-source QR generator. Codes never expire, never redirect, never leave your device. Zero network requests.",
  "homepage_url": "https://github.com/mundentracie/trustqr",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustQR — local QR generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "key": ""
}
